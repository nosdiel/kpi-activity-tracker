# =============================================================================
# .env.example — copy to .env and fill in real values for local/self-hosted use.
# Never commit a real .env. All Toast & Square credentials are stored per-location
# in the `locations` table (server-side only); they are NOT environment variables.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — CLIENT-SAFE (exposed to browser bundle via Vite)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# -----------------------------------------------------------------------------
# Supabase — SERVER-ONLY (used inside TanStack server functions / API routes)
# Mirror of the VITE_ values plus the service role key.
# When migrating to Firebase Functions / Cloud Run, set these in the
# function runtime config (e.g. `firebase functions:secrets:set SUPABASE_SERVICE_ROLE_KEY`).
# -----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
SUPABASE_PROJECT_ID=YOUR-PROJECT-REF
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-NEVER-EXPOSE-TO-BROWSER

# -----------------------------------------------------------------------------
# Lovable platform (auto-provisioned on Lovable; set manually if self-hosting)
# -----------------------------------------------------------------------------
LOVABLE_API_KEY=optional-only-needed-if-using-lovable-ai-gateway-or-connectors

# -----------------------------------------------------------------------------
# Node runtime
# -----------------------------------------------------------------------------
NODE_ENV=development

# =============================================================================
# NOT environment variables — stored in Supabase `locations` table per row:
#   pos_provider                     ('toast' | 'square' | 'manual')
#   square_location_id, square_access_token
#   toast_restaurant_guid, toast_api_url
#   toast_client_id, toast_client_secret           (Standard API)
#   toast_analytics_client_id, toast_analytics_client_secret  (ERA Analytics API)
# All Toast/Square HTTP calls happen in src/lib/api/*.functions.ts (server-only).
# =============================================================================
